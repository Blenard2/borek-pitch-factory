{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://borek.ai/contracts/email_draft.schema.json",
  "title": "EmailDraftEnvelope",
  "description": "TSK-013: three draft lengths persist in the API. Confirm never sends mail. Edits are saved per length against a draft revision; a confirmation names the reviewed revision; the export is an unsent file.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "opportunity_id", "journey_stage", "draft"],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "opportunity_id": {
      "type": "string",
      "format": "uuid"
    },
    "journey_stage": {
      "type": "string",
      "enum": ["first_contact", "deepening", "concretisation"]
    },
    "draft": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "send_status",
        "selected_length",
        "lengths",
        "confirmed_at",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "status": {
          "type": "string",
          "enum": ["draft", "confirmed"]
        },
        "send_status": {
          "const": "not_sent"
        },
        "selected_length": {
          "type": ["string", "null"],
          "enum": ["short", "medium", "extensive", null]
        },
        "lengths": {
          "type": "object",
          "additionalProperties": false,
          "required": ["short", "medium", "extensive"],
          "properties": {
            "short": { "$ref": "#/$defs/LengthBody" },
            "medium": { "$ref": "#/$defs/LengthBody" },
            "extensive": { "$ref": "#/$defs/LengthBody" }
          }
        },
        "confirmed_at": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "description": "Increases with every saved change. A write names the revision it is based on."
        },
        "confirmed_revision": {
          "type": ["integer", "null"],
          "minimum": 1,
          "description": "The revision the owner reviewed and confirmed. Null once the draft is edited again."
        },
        "confirmed_by": {
          "type": ["string", "null"],
          "format": "uuid"
        },
        "source": {
          "oneOf": [{ "$ref": "#/$defs/FinalizedSource" }, { "type": "null" }],
          "description": "The finalized Master Presentation V2 package the draft was written from. Null for drafts of other stages and for standalone PPT #2 opportunities."
        },
        "source_status": {
          "type": "string",
          "enum": ["valid", "changed", "not_applicable"]
        },
        "review_flags": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "review": {
          "oneOf": [{ "$ref": "#/$defs/Review" }, { "type": "null" }]
        },
        "recipients": {
          "oneOf": [{ "$ref": "#/$defs/Recipients" }, { "type": "null" }]
        },
        "attachments": {
          "type": "array",
          "items": { "$ref": "#/$defs/Attachment" }
        },
        "word_limits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["short", "medium", "extensive"],
          "properties": {
            "short": { "type": "integer", "minimum": 1 },
            "medium": { "type": "integer", "minimum": 1 },
            "extensive": { "type": "integer", "minimum": 1 }
          }
        },
        "writer": {
          "description": "Who wrote the generated text. Null for drafts from before this was recorded and for other journey stages.",
          "oneOf": [{ "$ref": "#/$defs/Writer" }, { "type": "null" }]
        }
      }
    }
  },
  "$defs": {
    "LengthBody": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject", "body", "word_count"],
      "properties": {
        "subject": { "type": "string", "minLength": 1 },
        "body": { "type": "string", "minLength": 1 },
        "word_count": { "type": "integer", "minimum": 1 },
        "edited": { "type": "boolean", "description": "True once the owner saved a change to this length." }
      }
    },
    "FinalizedSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "product_version",
        "finalized_at",
        "presentation_id",
        "presentation_version_id",
        "version_number",
        "snapshot_hash"
      ],
      "properties": {
        "kind": { "const": "master_presentation_v2" },
        "product_version": { "const": "V2" },
        "finalized_at": { "type": "string", "format": "date-time" },
        "presentation_id": { "type": "string", "format": "uuid" },
        "presentation_version_id": { "type": "string", "format": "uuid" },
        "version_number": { "type": "integer", "minimum": 1 },
        "snapshot_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "generation_fingerprint": { "type": ["string", "null"] },
        "approved_discovery_version_id": { "type": ["string", "null"] },
        "approved_discovery2_version_id": { "type": ["string", "null"] },
        "base_presentation_version_id": { "type": ["string", "null"] },
        "transcript_id": { "type": ["string", "null"] },
        "transcript_revision": { "type": ["string", "null"] },
        "meeting_review_confirmed_at": { "type": ["string", "null"] },
        "extraction_execution_mode": { "type": ["string", "null"] },
        "confirmed_finding_count": { "type": ["integer", "null"] },
        "excluded_finding_count": { "type": ["integer", "null"] },
        "renderer_version": { "type": "string", "minLength": 1 }
      }
    },
    "Writer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "model", "prompt_version", "verified", "fallback_reason", "checked_sentences"],
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["ai", "fallback", "deterministic"],
          "description": "ai: written by the model and accepted by the grounding checks. fallback: AI writing was attempted and not used; the rule-based writer wrote the text. deterministic: AI writing is not enabled; the rule-based writer wrote the text."
        },
        "model": { "type": ["string", "null"] },
        "prompt_version": { "type": "string" },
        "verified": { "type": "boolean", "description": "True only for mode ai: every sentence passed the rule checks and the grounding verifier." },
        "fallback_reason": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["code", "message"],
              "properties": { "code": { "type": "string" }, "message": { "type": "string" } }
            },
            { "type": "null" }
          ]
        },
        "checked_sentences": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "Review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checks", "acknowledged_flags"],
      "properties": {
        "checks": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "acknowledged_flags": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "Person": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "email"],
      "properties": {
        "name": { "type": ["string", "null"] },
        "email": { "type": "string", "minLength": 3 }
      }
    },
    "Recipients": {
      "type": "object",
      "additionalProperties": false,
      "required": ["to", "cc", "sender"],
      "properties": {
        "to": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/Person" } },
        "cc": { "type": "array", "items": { "$ref": "#/$defs/Person" } },
        "sender": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "role", "email"],
          "properties": {
            "name": { "type": "string" },
            "role": { "type": ["string", "null"] },
            "email": { "type": "string", "minLength": 3 }
          }
        }
      }
    },
    "Attachment": {
      "type": "object",
      "additionalProperties": false,
      "description": "One attachment the email can carry: a generated document of the finalized package (BAP-7: Discovery 1, Discovery 2, Master Presentation V1 or V2, pinned to the version the finalized V2 was built from), or a file the owner uploaded for this email (BAP-3, origin external, key external:<id>).",
      "required": [
        "key",
        "artifact",
        "format",
        "file_name",
        "selected",
        "available",
        "size_bytes",
        "presentation_id",
        "presentation_version_id",
        "artifact_version_id",
        "version_number",
        "product_version",
        "download_path",
        "origin",
        "uploaded_at"
      ],
      "properties": {
        "key": {
          "anyOf": [
            { "enum": ["pdf", "pptx", "v1_pdf", "v1_pptx", "discovery1_docx", "discovery2_docx"] },
            { "type": "string", "pattern": "^external:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" }
          ]
        },
        "artifact": { "enum": ["master_presentation_v2", "master_presentation_v1", "discovery_1", "discovery_2", "external"] },
        "format": { "type": "string", "enum": ["pptx", "pdf", "docx", "xlsx", "png", "jpg", "jpeg", "txt", "csv"] },
        "file_name": { "type": "string", "minLength": 1 },
        "selected": { "type": "boolean" },
        "available": { "type": "boolean" },
        "size_bytes": { "type": ["integer", "null"], "minimum": 0 },
        "presentation_id": { "type": ["string", "null"], "format": "uuid" },
        "presentation_version_id": { "type": ["string", "null"], "format": "uuid" },
        "artifact_version_id": { "type": ["string", "null"], "format": "uuid" },
        "version_number": { "type": ["integer", "null"] },
        "product_version": { "enum": ["V1", "V2", "Discovery 1", "Discovery 2", "Uploaded"] },
        "download_path": { "type": ["string", "null"] },
        "origin": { "enum": ["generated", "external"], "description": "generated: a document of the package. external: uploaded by the owner; never evidence for a statement in the email." },
        "uploaded_at": { "type": ["string", "null"] }
      }
    }
  }
}
